# Exact public HTTPS origin advertised to MCP/GPT Actions and remote runners.
# Do not include a trailing slash.
WEBCODEX_PUBLIC_URL=https://webcodex.example.com

# Generate with: openssl rand -hex 32
WEBCODEX_TOKEN=replace-with-a-long-random-secret

# Local address consumed by your existing host reverse proxy.
WEBCODEX_HOST_IP=127.0.0.1
WEBCODEX_HOST_PORT=8080

RUST_LOG=info
WEBCODEX_MCP_MODEL_SURFACE=local-coding-v1
