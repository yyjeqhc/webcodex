*.sh text eol=lf
*.toml text eol=lf
# Benchmark fixture bytes are part of the independent oracle.
tests/fixtures/agent-loop-multi-file/*.txt text eol=lf
# Runtime text snapshots preserve meaningful source/log whitespace and empty fields.
# Limit the blank-at-eol exception to this exact evidence corpus.
src/tool_runtime/tests/cli_runtime_snapshots/*.txt text eol=lf whitespace=-blank-at-eol
# CLI rendering snapshots also compare the actual UTF-8 text byte-for-byte.
src/mcp_tests/cli/text_snapshots/*.txt text eol=lf

# Frontend freshness checks compare these generated assets byte-for-byte.
frontend/dist/** text eol=lf
src/mcp_pdf_app.html text eol=lf
src/mcp_work_result_app.html text eol=lf
src/mcp_docx_app.html text eol=lf
# Preserve the exact SheetJS distribution bytes used by the SHA-256 check.
frontend/vendor/sheetjs/xlsx.mini.min.js -text
# Keep spreadsheet bundle inputs and generated HTML identical across checkouts.
frontend/vendor/sheetjs/LICENSE text eol=lf
frontend/scripts/build-spreadsheet.mjs text eol=lf
frontend/src/mcp-apps/spreadsheet-*.js text eol=lf
src/mcp_spreadsheet_app.html text eol=lf
