# Agent-side project file.
#
# Place one *.toml project registration record per project under the Runner
# project registry (default ~/.config/webcodex/project-registry, or whatever
# project_registry_dir is set to in runner.toml). The Runner reads these and
# reports them to the server at
# registration; the server exposes them as runtime ids
# agent:<client_id>:<project_id>.
#
# The server does NOT need a matching server-side [projects.<id>] block.
# Project paths and policies come from this file, registered by the agent.

id = "webcodex"
path = "/root/git/webcodex"
name = "WebCodex"
allow_patch = true
kind = "rust"
shell_profile = "rust"
description = "WebCodex Runtime repository"
