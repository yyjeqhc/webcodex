# systemd unit for the WebPi server.
#
# Copy to /etc/systemd/system/webpi.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now webpi
#
# The server is a zero-project-config relay: it does NOT read a projects.toml
# for runtime project discovery. Projects are registered by agents as
# agent:<client_id>:<project_id>. Do not restore PROJECTS_CONFIG as the runtime
# project source.
#
# Keep the server bound to 127.0.0.1 behind a reverse proxy that terminates
# TLS. WEBPI_TOKEN is the application-layer gate; TLS is the transport gate.

[Unit]
Description=WebPi runtime server (zero-config relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webpi
Group=webpi

# Runtime data lives here (SQLite DB and durable runtime state). Persistent.
StateDirectory=webpi
WorkingDirectory=/opt/webpi

ExecStart=/opt/webpi/webpi-server

# Load secrets + public URL from the env file (chmod 0600, owner root).
# See webcodex.env.example for the full set; this legacy-named example remains
# read-protected as a sensitive env path and must be migrated separately.
EnvironmentFile=/etc/webpi/webpi.env

# Sensible defaults; override in the env file if needed.
Environment=RUST_LOG=info

Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/webpi

[Install]
WantedBy=multi-user.target
