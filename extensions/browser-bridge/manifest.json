{
  "manifest_version": 3,
  "name": "WebCodex Browser Bridge",
  "version": "0.1.0",
  "description": "Explicitly share one current Chrome tab with your local WebCodex Runner. Detaching never closes Chrome.",
  "minimum_chrome_version": "118",
  "key": "",
  "permissions": ["activeTab", "debugger", "nativeMessaging"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Share or revoke this tab"}
}
